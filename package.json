    "./auth-service": "./auth-service.js",
    "./auth-providers": "./auth-providers.js",
    "./api-service": "./api-service.js",
    "./api-transports": "./api-transports.js",
    "./activity-service": "./activity-service.js",
    "./format": "./format.js",
    "./element-permission-plugin": "./element-permission-plugin.js"
  },
  "files": [
    "core.js",
    "desktop.js",
    "ElementBuilder.js",
    "auth-service.js",
    "auth-providers.js",
    "api-service.js",
    "api-transports.js",
    "activity-service.js",
    "format.js",
    "element-permission-plugin.js",
    "ui.js",
    "ui/",
    "css/",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run"
