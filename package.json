{
  "name": "desktop-engine",
  "version": "2.2.0",
  "description": "DesktopEngine — framework vanilla JS (ES Modules) para SPAs estilo desktop: window manager, menus, taskbar, signals reativos, segurança zero-trust (RBAC), autenticação genérica e permissões de elementos.",
  "type": "module",
  "main": "./ui.js",
  "exports": {
    ".": "./ui.js",
    "./core": "./core.js",
